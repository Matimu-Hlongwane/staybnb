@model Staybnb.Controllers.AccountController.RegisterViewModel
@{
    ViewData["Title"] = "Create your account";
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-5">
            <div class="card shadow-sm border-0">
                <div class="card-body p-4">
                    <h1 class="h3 mb-2">Join Staybnb</h1>
                    <p class="text-muted">Create an account to discover your next stay.</p>

                    <form asp-controller="Account" asp-action="Register" method="post">
                        <div asp-validation-summary="All" class="text-danger mb-3"></div>

                        <div class="mb-3">
                            <label asp-for="Email" class="form-label"></label>
                            <input asp-for="Email" class="form-control"
                                   type="email" autocomplete="email" />
                            <span asp-validation-for="Email" class="text-danger"></span>
                        </div>

                        <div class="mb-3">
                            <label asp-for="Password" class="form-label"></label>
                            <input asp-for="Password" class="form-control"
                                   autocomplete="new-password" />
                            <span asp-validation-for="Password" class="text-danger"></span>
                            <small class="text-muted">Use at least 6 characters.</small>
                        </div>

                        <div class="mb-3">
                            <label asp-for="ConfirmPassword" class="form-label"></label>
                            <input asp-for="ConfirmPassword" class="form-control"
                                   autocomplete="new-password" />
                            <span asp-validation-for="ConfirmPassword" class="text-danger"></span>
                        </div>

                        <button type="submit" class="btn btn-primary w-100">
                            Create account
                        </button>
                    </form>

                    <p class="mt-3 mb-0 text-center">
                        Already registered?
                        <a asp-controller="Account" asp-action="Login">Log in</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
