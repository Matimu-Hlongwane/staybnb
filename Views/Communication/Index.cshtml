@model IEnumerable<Staybnb.Models.StaybnbMessage>
@{
    ViewData["Title"] = "Messages";
}

<section class="py-4">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-2 mb-4">
        <div>
            <h1 class="fw-bold">Messages</h1>
            <p class="text-secondary mb-0">Communication between Staybnb users.</p>
        </div>
        <a asp-action="Create" class="btn btn-dark">New message</a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (!Model.Any())
    {
        <div class="rounded-4 p-5 text-center" style="background:#f4f0e9;">
            <h2 class="h5">No messages yet</h2>
            <p class="text-secondary mb-0">Your conversations will appear here.</p>
        </div>
    }
    else
    {
        @foreach (var message in Model)
        {
            <article class="card border-0 shadow-sm rounded-4 mb-3">
                <div class="card-body p-4">
                    <p class="small text-secondary mb-2">
                        @(message.SenderUserId == User.FindFirst(System.Security.Claims.ClaimTypes.NameIdentifier)?.Value ? "Sent" : "Received")
                        · @message.SentAt.ToLocalTime().ToString("dd MMM yyyy HH:mm")
                    </p>
                    <p class="mb-0" style="white-space:pre-wrap">@message.Body</p>
                </div>
            </article>
        }
    }
</section>
