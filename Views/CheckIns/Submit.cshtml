@{
    ViewData["Title"] = "Submit identity verification";
}

<section class="py-4">
    <h1 class="fw-bold mb-2">Identity verification</h1>
    <p class="text-secondary mb-4">Booking: @ViewBag.PropertyTitle</p>

    <div class="card border-0 shadow-sm rounded-4" style="max-width:620px;">
        <div class="card-body p-4">
            <p>
                Select the type of identity document you will present to the host.
                This form records the document type only; it does not upload or store your ID or passport.
            </p>
            <form asp-action="Submit" method="post">
                <input type="hidden" name="bookingId" value="@ViewBag.BookingId" />
                <div asp-validation-summary="ModelOnly" class="text-danger mb-3"></div>

                <div class="mb-4">
                    <label for="documentType" class="form-label">Document type</label>
                    <select id="documentType" name="documentType" class="form-select" required>
                        <option value="">Choose a document</option>
                        <option value="National ID">National ID</option>
                        <option value="Passport">Passport</option>
                        <option value="Driver's Licence">Driver's Licence</option>
                    </select>
                </div>

                <button type="submit" class="btn btn-dark">Submit for review</button>
                <a asp-action="Index" class="btn btn-outline-secondary">Cancel</a>
            </form>
        </div>
    </div>
</section>
